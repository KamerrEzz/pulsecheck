{{#each services}}
    {{> single-service service=this}}
{{else}}
    <div class="col-span-full text-center py-12">
        <p class="text-gray-500 text-lg mb-4">You haven't added any services yet.</p>
        <a href="/services/new" class="bg-blue-600 text-white px-6 py-3 rounded hover:bg-blue-700">Add Your First Service</a>
    </div>
{{/each}}