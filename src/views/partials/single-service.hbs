<div class="service-card bg-white rounded-lg shadow-md overflow-hidden border-l-4 {{statusClass service.status 'border'}} transition-all duration-300 hover:shadow-lg">
    <div class="p-6">
        <div class="flex justify-between items-start mb-4">
            <h3 class="text-xl font-bold text-gray-800 truncate" title="{{service.name}}">{{service.name}}</h3>
            <span class="px-2 py-1 text-xs font-semibold rounded {{statusClass service.status 'badge'}}">
                {{service.status}}
            </span>
        </div>
        
        <p class="text-gray-600 text-sm mb-2 truncate" title="{{service.url}}">{{service.url}}</p>
        
        <div class="flex items-center text-sm text-gray-500 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {{service.checkInterval}}s interval
        </div>

        {{#if service.responseTime}}
        <div class="flex items-center text-sm text-gray-500 mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            {{service.responseTime}}ms
        </div>
        {{/if}}

        {{#if service.history}}
        <div class="flex gap-1 mb-4 h-4 items-end">
            {{#each service.history}}
                <div class="w-2 rounded-sm {{#if (eq this 'UP')}}bg-green-400 h-3{{else}}bg-red-400 h-4{{/if}}" title="{{this}}"></div>
            {{/each}}
        </div>
        {{/if}}

        <div class="flex justify-between items-center mt-4 border-t pt-4">
            <div class="flex space-x-2">
                <a href="/services/{{service.id}}" class="text-blue-600 hover:text-blue-800 text-sm font-medium">Details</a>
                <button 
                    class="text-xs bg-gray-200 hover:bg-gray-300 text-gray-700 py-1 px-2 rounded transition-colors flex items-center gap-1"
                    hx-post="/services/{{service.id}}/check"
                    hx-target="closest .service-card"
                    hx-swap="outerHTML"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Check Now
                </button>
            </div>
            <div class="flex space-x-2">
                <a href="/services/{{service.id}}/edit" class="text-gray-500 hover:text-gray-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                </a>
                <button 
                    class="text-red-500 hover:text-red-700"
                    hx-post="/services/{{service.id}}/delete"
                    hx-confirm="Are you sure you want to delete this service?"
                    hx-target="closest .service-card"
                    hx-swap="outerHTML swap:500ms"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>