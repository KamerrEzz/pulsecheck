{{#each logs}}
<tr class="hover:bg-gray-50 transition-colors border-b last:border-0">
    <td class="px-4 py-2 whitespace-nowrap text-xs text-gray-500">
        {{formatTime this.timestamp}}
    </td>
    <td class="px-4 py-2 whitespace-nowrap">
        <span class="px-2 py-0.5 inline-flex text-xs leading-4 font-semibold rounded-full {{#if (gte this.statusCode 400)}}bg-red-100 text-red-800{{else}}bg-green-100 text-green-800{{/if}}">
            {{this.statusCode}}
        </span>
    </td>
    <td class="px-4 py-2 whitespace-nowrap text-xs text-gray-500 font-mono">
        {{this.responseTime}}ms
    </td>
</tr>
{{/each}}