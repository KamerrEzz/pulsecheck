{{#each logs}}
<tr class="hover:bg-gray-50 transition-colors">
    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
        {{formatDate this.timestamp}}
    </td>
    <td class="px-6 py-4 whitespace-nowrap">
        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {{#if (eq this.statusCode 200)}}bg-green-100 text-green-800{{else}}bg-red-100 text-red-800{{/if}}">
            {{this.statusCode}}
        </span>
    </td>
    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
        {{this.responseTime}} ms
    </td>
    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
        {{this.message}}
    </td>
</tr>
{{/each}}