<div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold text-gray-800">Dashboard</h1>
            <span class="flex h-3 w-3 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
            </span>
            <span class="text-xs text-gray-500 font-medium uppercase tracking-wider">Live</span>
        </div>
        <div class="flex gap-4 items-center">
             <div class="relative">
                <input type="search" 
                       name="search" 
                       class="pl-10 pr-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 w-64" 
                       placeholder="Search services..."
                       hx-get="/services/partials/list"
                       hx-trigger="keyup changed delay:500ms, search"
                       hx-target="#service-list"
                       hx-swap="innerHTML">
                <div class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>
            <a href="/services/new" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors h-10 flex items-center">Add Service</a>
        </div>
    </div>

    <div id="service-list" 
         class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
         hx-get="/services/partials/list" 
         hx-trigger="every 5s" 
         hx-include="[name='search']"
         hx-swap="innerHTML">
        {{> service-list}}
    </div>
</div>