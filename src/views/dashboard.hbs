<div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold text-gray-800">Dashboard</h1>
            <span class="flex h-3 w-3 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
            </span>
            <span class="text-xs text-gray-500 font-medium uppercase tracking-wider">Live</span>
        </div>
        <a href="/services/new" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors">Add Service</a>
    </div>

    <div id="service-list" 
         class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
         hx-get="/services/partials/list" 
         hx-trigger="every 5s" 
         hx-swap="innerHTML">
        {{> service-list}}
    </div>
</div>