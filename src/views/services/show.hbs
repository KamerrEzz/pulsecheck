<div class="max-w-6xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">{{service.name}}</h1>
            <a href="{{service.url}}" target="_blank" class="text-blue-600 hover:underline">{{service.url}}</a>
        </div>
        <div class="text-right">
            <span class="inline-block px-4 py-2 rounded-lg text-lg font-bold {{#if (eq service.status 'UP')}}bg-green-100 text-green-800{{else if (eq service.status 'DOWN')}}bg-red-100 text-red-800{{else}}bg-yellow-100 text-yellow-800{{/if}}">
                {{service.status}}
            </span>
            <p class="text-gray-500 mt-1">Checked every {{service.checkInterval}}s</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow-md lg:col-span-2">
            <h3 class="text-lg font-bold mb-4">Response Time (Last 24h)</h3>
            <canvas id="responseTimeChart"></canvas>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-lg font-bold mb-4">Latest Stats</h3>
            <div class="space-y-4">
                <div class="flex justify-between border-b pb-2">
                    <span class="text-gray-600">Current Response Time</span>
                    <span class="font-bold">{{service.responseTime}} ms</span>
                </div>
                <div class="flex justify-between border-b pb-2">
                    <span class="text-gray-600">Last Check</span>
                    <span class="font-bold">Just now</span> 
                    <!-- We could pass last check time from redis if stored -->
                </div>
                 <div class="mt-6">
                    <a href="/services/{{service.id}}/edit" class="block w-full text-center bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded mb-2">
                        Edit Settings
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const events = {{{json events}}};
    
    const ctx = document.getElementById('responseTimeChart').getContext('2d');
    
    // Process data for Chart.js
    const labels = events.map(e => new Date(e.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}));
    const data = events.map(e => e.responseTime);
    const backgroundColors = events.map(e => e.statusCode >= 400 ? 'rgba(239, 68, 68, 0.5)' : 'rgba(59, 130, 246, 0.5)');
    const borderColors = events.map(e => e.statusCode >= 400 ? 'rgb(239, 68, 68)' : 'rgb(59, 130, 246)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Response Time (ms)',
                data: data,
                borderColor: 'rgb(59, 130, 246)',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                tension: 0.1,
                fill: true,
                pointBackgroundColor: borderColors,
                pointBorderColor: borderColors
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'ms'
                    }
                }
            }
        }
    });
</script>
