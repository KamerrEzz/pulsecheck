<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Section -->
    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="flex-1 min-w-0">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                {{service.name}}
            </h2>
            <div class="mt-1 flex flex-col sm:flex-row sm:flex-wrap sm:mt-0 sm:space-x-6">
                <div class="mt-2 flex items-center text-sm text-gray-500">
                    <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                    </svg>
                    <a href="{{service.url}}" target="_blank" class="hover:underline">{{service.url}}</a>
                </div>
                <div class="mt-2 flex items-center text-sm text-gray-500">
                    <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Check interval: {{service.checkInterval}}s
                </div>
            </div>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4 space-x-3">
             <button
                hx-post="/services/{{service.id}}/check?view=details"
                hx-target="#status-card"
                hx-swap="outerHTML"
                class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                Check Now
            </button>
            {{#if aiEnabled}}
            <button
                id="ai-analyze-btn"
                type="button"
                onclick="startAiAnalysis({{service.id}})"
                class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed">
                <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                Analyze with AI
            </button>
            {{/if}}
            <a href="/services/{{service.id}}/edit" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                Edit Service
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
        <!-- Status Card -->
        {{> service-status-card}}

        <!-- Uptime Card -->
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-md bg-blue-50 p-3">
                            <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">1h Uptime</dt>
                            <dd>
                                <div class="text-lg font-medium text-gray-900">{{stats.uptime}}%</div>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Avg Response Card -->
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-md bg-purple-50 p-3">
                            <svg class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Avg Response (1h)</dt>
                            <dd>
                                <div class="text-lg font-medium text-gray-900">{{stats.avgResponseTime}}ms</div>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Last Check Card -->
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-md bg-yellow-50 p-3">
                            <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Last Check</dt>
                            <dd>
                                <div class="text-lg font-medium text-gray-900">
                                    {{#if service.lastCheck}}
                                        {{formatDate service.lastCheck}}
                                    {{else}}
                                        Just now
                                    {{/if}}
                                </div>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Chart Section (2 cols) -->
        <div class="lg:col-span-2 bg-white rounded-lg shadow">
            <div class="p-6 border-b border-gray-200">
                <h3 class="text-lg leading-6 font-medium text-gray-900">Response Time History (1h)</h3>
            </div>
            <div class="p-6">
                <div class="relative h-80 w-full">
                    <canvas id="responseTimeChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Logs Section (1 col) -->
        <div class="bg-white rounded-lg shadow flex flex-col h-[500px]">
            <div class="p-4 border-b border-gray-200 flex justify-between items-center bg-gray-50 rounded-t-lg">
                <h3 class="text-base font-bold text-gray-800">Recent Logs</h3>
                <span class="relative flex h-2.5 w-2.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
                </span>
            </div>
            <div class="flex-1 overflow-auto custom-scrollbar">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm">
                        <tr>
                            <th scope="col" class="px-4 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider bg-gray-50">Time</th>
                            <th scope="col" class="px-4 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider bg-gray-50">Status</th>
                            <th scope="col" class="px-4 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider bg-gray-50">MS</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200" 
                           hx-get="/services/{{service.id}}/logs" 
                           hx-trigger="every 5s" 
                           hx-swap="innerHTML">
                        {{> service-logs logs=logs}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{#if aiEnabled}}
    <!-- AI Analysis Results -->
    <div id="ai-results" class="mt-8 bg-white rounded-lg shadow hidden">
        <div class="p-6 border-b border-gray-200">
            <h3 class="text-lg leading-6 font-medium text-gray-900">AI Analysis</h3>
        </div>
        <div class="p-6">
            <div id="ai-loading" class="hidden flex items-center text-gray-500 text-sm mb-4">
                <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                Analizando...
            </div>

            <div id="ai-error" class="hidden bg-red-50 border border-red-200 text-red-700 rounded-md p-4 mb-4 flex items-start justify-between gap-4">
                <p id="ai-error-message" class="text-sm"></p>
                <button type="button" onclick="startAiAnalysis({{service.id}})" class="text-sm font-medium text-red-700 hover:text-red-900 underline flex-shrink-0">
                    Reintentar
                </button>
            </div>

            <div id="ai-narrative-output" class="text-sm text-gray-700 whitespace-pre-wrap leading-relaxed mb-4"></div>

            <div id="ai-structured" class="hidden mb-4">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                    <span id="ai-severity-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium"></span>
                    <span id="ai-category-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 capitalize"></span>
                </div>
                <div class="bg-indigo-50 border border-indigo-100 rounded-md p-3">
                    <p class="text-xs font-semibold text-indigo-800 uppercase tracking-wide mb-1">Recommendation</p>
                    <p id="ai-recommendation" class="text-sm text-indigo-900"></p>
                </div>
            </div>

            <div id="ai-metrics" class="hidden text-xs text-gray-400 border-t border-gray-100 pt-3"></div>
        </div>
    </div>
    {{/if}}
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f1f1; 
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #c1c1c1; 
        border-radius: 3px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8; 
    }
</style>

<script>
    let eventsData = {{{json events}}};
    // Defensive check: if events comes as a string (double encoded), parse it
    if (typeof eventsData === 'string') {
        try {
            eventsData = JSON.parse(eventsData);
        } catch (e) {
            console.error('Failed to parse events JSON:', e);
            eventsData = [];
        }
    }
    const events = eventsData;

    const ctx = document.getElementById('responseTimeChart').getContext('2d');
    
    // Check if we have data
    if (events.length === 0) {
        // Show empty state on canvas parent
        const container = document.getElementById('responseTimeChart').parentElement;
        container.innerHTML = '<div class="flex h-full items-center justify-center text-gray-400">No data available yet</div>';
    } else {
        // Process data for Chart.js
        const labels = events.map(e => new Date(e.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}));
        const data = events.map(e => e.responseTime);
        const borderColors = events.map(e => e.statusCode >= 400 ? 'rgb(239, 68, 68)' : 'rgb(59, 130, 246)');
        // Fix: Make points visible always, but highlight errors
        const pointColors = events.map(e => e.statusCode >= 400 ? 'rgb(239, 68, 68)' : 'rgb(59, 130, 246)');
        const pointRadii = events.map(e => e.statusCode >= 400 ? 4 : 2);

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Response Time (ms)',
                    data: data,
                    borderColor: 'rgb(59, 130, 246)',
                    backgroundColor: 'rgba(59, 130, 246, 0.05)',
                    borderWidth: 2,
                    tension: 0.3,
                    fill: true,
                    pointRadius: pointRadii,
                    pointHoverRadius: 5,
                    pointBackgroundColor: pointColors,
                    pointBorderColor: borderColors
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    intersect: false,
                    mode: 'index',
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12,
                        titleFont: {
                            size: 14
                        },
                        bodyFont: {
                            size: 13
                        },
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y + ' ms';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            maxTicksLimit: 8,
                            maxRotation: 0
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            borderDash: [2, 4],
                            color: 'rgba(0, 0, 0, 0.05)'
                        },
                        title: {
                            display: true,
                            text: 'Milliseconds'
                        }
                    }
                }
            }
        });
    }
</script>

<script>
    const SEVERITY_BADGE_CLASSES = {
        info: 'bg-blue-100 text-blue-800',
        warning: 'bg-yellow-100 text-yellow-800',
        critical: 'bg-red-100 text-red-800'
    };

    function aiEl(id) {
        return document.getElementById(id);
    }

    function showAiError(message) {
        aiEl('ai-loading').classList.add('hidden');
        aiEl('ai-error-message').textContent = message || 'Ocurrió un error inesperado. Intentá de nuevo.';
        aiEl('ai-error').classList.remove('hidden');
    }

    function renderAiStructured(analysis) {
        const severityBadge = aiEl('ai-severity-badge');
        severityBadge.textContent = analysis.severity;
        severityBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ' +
            (SEVERITY_BADGE_CLASSES[analysis.severity] || 'bg-gray-100 text-gray-800');

        aiEl('ai-category-badge').textContent = analysis.category;
        aiEl('ai-recommendation').textContent = analysis.recommendation;
        aiEl('ai-structured').classList.remove('hidden');

        const seconds = (analysis.latencyMs / 1000).toFixed(1);
        aiEl('ai-metrics').textContent =
            `${analysis.model} · ${seconds}s · ${analysis.inputTokens.toLocaleString()} tokens in · ${analysis.outputTokens.toLocaleString()} tokens out`;
        aiEl('ai-metrics').classList.remove('hidden');
    }

    async function startAiAnalysis(serviceId) {
        const btn = aiEl('ai-analyze-btn');
        const resultsEl = aiEl('ai-results');
        const outputEl = aiEl('ai-narrative-output');

        btn.disabled = true;
        resultsEl.classList.remove('hidden');
        aiEl('ai-error').classList.add('hidden');
        aiEl('ai-structured').classList.add('hidden');
        aiEl('ai-metrics').classList.add('hidden');
        aiEl('ai-loading').classList.remove('hidden');
        outputEl.textContent = '';

        try {
            const response = await fetch(`/services/${serviceId}/analyze`, {
                method: 'POST',
                headers: { Accept: 'text/event-stream' }
            });

            const contentType = response.headers.get('content-type') || '';
            if (!contentType.includes('text/event-stream')) {
                const body = await response.json().catch(() => ({}));
                showAiError(body.message);
                return;
            }

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';
            let narrativeStarted = false;

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const messages = buffer.split('\n\n');
                buffer = messages.pop();

                for (const message of messages) {
                    const line = message.trim();
                    if (!line.startsWith('data:')) continue;

                    let event;
                    try {
                        event = JSON.parse(line.slice(5).trim());
                    } catch (parseError) {
                        continue;
                    }

                    if (event.type === 'narrative-chunk') {
                        if (!narrativeStarted) {
                            aiEl('ai-loading').classList.add('hidden');
                            narrativeStarted = true;
                        }
                        outputEl.textContent += event.content;
                    } else if (event.type === 'narrative-reset') {
                        outputEl.textContent = '';
                        narrativeStarted = false;
                    } else if (event.type === 'done') {
                        aiEl('ai-loading').classList.add('hidden');
                        renderAiStructured(event.analysis);
                    } else if (event.type === 'error') {
                        showAiError(event.message);
                    }
                }
            }
        } catch (networkError) {
            showAiError('No se pudo conectar con el servicio de IA. Verificá tu conexión e intentá de nuevo.');
        } finally {
            btn.disabled = false;
        }
    }
</script>